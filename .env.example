# Copy to .env.local for development. Every key here must also exist in the
# Vercel project's Environment Variables for the Production environment.

# ── Database (Supabase) ───────────────────────────
# Runtime: transaction pooler, port 6543. Serverless needs this or connections exhaust.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations only: session pooler / direct connection, port 5432. Required by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres"

# ── Clerk Auth ────────────────────────────────────
# Production needs a Clerk *production* instance: pk_live_ / sk_live_ keys plus the
# CNAME records Clerk gives you on your own domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/library"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/library"
# From the Clerk dashboard webhook pointed at https://YOUR_DOMAIN/api/webhooks/clerk
CLERK_WEBHOOK_SECRET="whsec_..."

# ── AI / TTS ──────────────────────────────────────
OPENAI_API_KEY="sk-..."
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# ── Billing (Paddle) ──────────────────────────────
# Checkout runs entirely in the browser via Paddle.js and the webhook verifies
# signatures with the signing secret alone, so this integration needs NO Paddle API key.
# "sandbox" or "production" — must match the dashboard the token and price come from.
NEXT_PUBLIC_PADDLE_ENV="sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# The Pro price. Attach the 7-day trial to this price in Catalog -> Prices -> Trial period.
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID="pri_..."
# Paddle dashboard webhook pointed at https://YOUR_DOMAIN/api/subscriptions/webhook
PADDLE_WEBHOOK_SECRET=""

# ── Storage ───────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── App ───────────────────────────────────────────
# No trailing slash. Must be the live domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated emails granted the ADMIN role.
ADMIN_EMAILS=""

# ── Web push ──────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# ── Cron ──────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/push/send-daily.
CRON_SECRET=""
